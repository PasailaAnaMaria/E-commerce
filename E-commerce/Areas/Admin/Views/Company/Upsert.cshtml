@{
}
  @model Company 


<div class="row pb-2">
    <h2 class="text-primary">@(Model.Id!=0?"Update":"Create" ) Company</h2>
    <hr />
 </div>
<form method="post" enctype="multipart/form-data">
    <input asp-for="Id" hidden/>
    <div class="row">
        <div class="col-12">
            <div class="border p-3 mt-4">
                <div class="mb-3 row">
                    <label asp-for="Name" class="p-0"></label>
                    <input class="form-control" asp-for="Name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-3 row">
                    <label asp-for="StreetAddress" class="p-0"></label>
                    <input class="form-control" asp-for="StreetAddress" />
                    <span asp-validation-for="StreetAddress" class="text-danger"></span>
                </div>
               
                <div class="mb-3 row">
                    <label asp-for="City" class="p-0"></label>
                    <input class="form-control" asp-for="City" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
                <div class="mb-3 row">
                    <label asp-for="State" class="p-0"></label>
                    <input class="form-control" asp-for="State" />
                    <span asp-validation-for="State" class="text-danger"></span>
                </div>
                <div class="mb-3 row">
                    <label asp-for="PostalCode" class="p-0"></label>
                    <input class="form-control" asp-for="PostalCode" />
                    <span asp-validation-for="PostalCode" class="text-danger"></span>
                </div>
                <div class="mb-3 row">
                    <label asp-for="PhoneNumber" class="p-0"></label>
                    <input class="form-control" asp-for="PhoneNumber" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
               

                <div class="row">
                    <div class="col-6 col-md-3">
                        @if (Model.Id != 0)
                        {
                            <button type="submit" class="btn btn-primary form-control">Update</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-primary form-control">Create</button>
                        }
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="Company" asp-action="Index" class="btn btn-outline-secondary form-control">Back to list</a>
                    </div>
                </div>


            </div>
        </div>
       
    </div>

</form>
@section Scripts {

    @* this is the script for text editor tiny  *@
    <script>
                         tinymce.init({
                             selector: 'textarea',
                             plugins: 'anchor autolink charmap codesample emoticons  lists  table visualblocks wordcount',
                             toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | align lineheight | numlist bullist indent outdent | emoticons charmap ',
                         });
    </script>
    
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}